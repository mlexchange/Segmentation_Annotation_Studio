TILED_URI=http://127.0.0.1:8010
# Leave blank for local dev: start_all.sh generates a strong TILED_API_KEY here on
# first run and passes it to Tiled via --api-key (anonymous
# access is read-only, the key authenticates writes/ingest). A blank value is safe —
# it is never sent as an (invalid) empty auth header.
TILED_API_KEY=
# Optional override: a separate key for the default "Local Data" server, if it
# should differ from TILED_API_KEY. Falls back to tiled/config.yml's
# authentication.single_user_api_key when both are unset.
TILED_LOCAL_API_KEY=
# Optional additional named Tiled servers, shown in the Browse server picker.
# Numbered contiguously starting at 1 (stops at the first missing _NAME/_URI).
# TILED_SERVER_1_NAME=Beamline 7.3.3
# TILED_SERVER_1_URI=https://tiled.example.org
# TILED_SERVER_1_API_KEY=

# Slash-separated path into the Tiled tree that Browse treats as its root
# (e.g. a specific dataset), overriding the built-in beamline-path heuristics.
TILED_BROWSE_PATH=
# Tiled path segment that /api/ingest/upload targets must fall under — rejects
# any container_path that isn't a child of this root.
TILED_INGEST_ROOT=browse

BROWSE_CACHE_TTL_SECONDS=300
# TTL for the per-server/technique/container_path facet-field-mapping cache.
BROWSE_FIELD_MAPPING_TTL_SECONDS=300

LOCAL_DATA_ROOT=~/data
# Optional additional server-authorized roots, separated by ':' on Unix or ';'
# on Windows. API callers may only select this root or descendants of these roots.
LOCAL_DATA_ROOTS=
EXPORT_ROOT=
# Thread-pool size for parallel export rendering (bounded by the number of slices).
EXPORT_WORKERS=16
# In-memory export/ingest job registries: completed (done/error) records older than
# this many seconds, or beyond this count, are pruned so a long-running server
# process doesn't accumulate unbounded state.
EXPORT_JOB_TTL_SECONDS=21600
EXPORT_MAX_JOBS=500
INGEST_JOB_TTL_SECONDS=21600
INGEST_MAX_JOBS=500

# Multipart upload quotas for /api/ingest/upload, enforced before any bytes are
# decoded — bounds disk/thread usage for an unauthenticated-by-default local API.
MAX_INGEST_FILES=5000
MAX_INGEST_FILE_BYTES=536870912
MAX_INGEST_TOTAL_BYTES=17179869184
# Reject an oversized request body (by its Content-Length header) before ASGI
# spools it to disk at all — defense-in-depth ahead of the quotas above.
MAX_REQUEST_BODY_BYTES=34359738368
# Decoded-array quotas applied when ingest reads an uploaded image/array file —
# independent of the raw upload-byte quotas above, since a small encoded file
# (e.g. a compressed TIFF) can still decode to a much larger in-memory array.
MAX_INGEST_DECODED_BYTES=1073741824
MAX_INGEST_DECODED_PIXELS=200000000
MAX_INGEST_ARRAY_DIMENSION=100000

# Train tab (DINOv3 + LoRA fine-tune / dlsia TUNet). Optional — needs the `ml`
# extra (torch, + dlsia for the TUNet family); start_all.sh installs it on
# capable hosts. Never enabled in the Docker image — the tab shows guidance
# there instead of failing.
# Directory scanned for pretrained DINOv3 checkpoints (dinov3_<arch>_pretrain_*.pth).
DINO_MODELS_DIR=
# Directory saved fine-tune runs (adapter + config + metrics) are written to.
DINO_RUNS_DIR=
# Force a device instead of auto-detecting mps > cuda > cpu (e.g. "cpu" if MPS
# is flaky for a particular op on your machine).
TRAIN_DEVICE=

# Production / Docker notes:
# - The container serves the SPA same-origin, so BROWSE_ALLOWED_ORIGINS can stay
#   empty. Set it (comma-separated) only for split frontend/backend origins.
# - Point TILED_URI/TILED_API_KEY at your external Tiled; mount LOCAL_DATA_ROOT
#   as a volume so annotation drafts/versions/exports survive restarts.
BROWSE_ALLOWED_ORIGINS=

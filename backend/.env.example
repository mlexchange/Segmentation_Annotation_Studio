TILED_URI=http://127.0.0.1:8010
# Leave empty to use authentication.single_user_api_key from tiled/config.yml
# (needed for local ingest/writes; anon access is read-only). Never commit a real
# production key. A blank *exported* value breaks the tiled client (illegal
# "Apikey " header) — start_all.sh / tiled_config clear or replace blanks.
TILED_API_KEY=
BROWSE_CACHE_TTL_SECONDS=300
LOCAL_DATA_ROOT=~/data
EXPORT_ROOT=
# Disjoint ipred (preprocess / train / conformal). start_all.sh sets this.
IPRED_URL=http://127.0.0.1:8003
# Optional Mark25 TomoJEPA weights (defaults to ipred/models/tomojepa25.pth).
# Requires: pip install -e '.[torch]' inside ipred/.
TOMOJEPA_WEIGHTS=
# Optional Mark11 TomoJEPA weights (defaults to ipred/models/tomojepa11.pth).
TOMOJEPA11_WEIGHTS=
# Optional ONNX exports (after: python -m ipred.scripts.export_tomojepa_onnx).
TOMOJEPA_ONNX=
TOMOJEPA11_ONNX=

# Production / Docker notes:
# - The container serves the SPA same-origin, so BROWSE_ALLOWED_ORIGINS can stay
#   empty. Set it (comma-separated) only for split frontend/backend origins.
# - Point TILED_URI/TILED_API_KEY at your external Tiled; mount LOCAL_DATA_ROOT
#   as a volume so annotation drafts/versions/exports survive restarts.
BROWSE_ALLOWED_ORIGINS=

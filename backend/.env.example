TILED_URI=http://127.0.0.1:8010
TILED_API_KEY=
BROWSE_CACHE_TTL_SECONDS=300
LOCAL_DATA_ROOT=~/data
EXPORT_ROOT=

# Production / Docker notes:
# - The container serves the SPA same-origin, so BROWSE_ALLOWED_ORIGINS can stay
#   empty. Set it (comma-separated) only for split frontend/backend origins.
# - Point TILED_URI/TILED_API_KEY at your external Tiled; mount LOCAL_DATA_ROOT
#   as a volume so annotation drafts/versions/exports survive restarts.
BROWSE_ALLOWED_ORIGINS=

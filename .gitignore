# Python
.venv/
.conda-py312/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Secrets — never commit
.env

# Tiled catalog database (binary, regenerated on first run via start_all.sh)
.tiled/catalog.db
.tiled/catalog.db-shm
.tiled/catalog.db-wal

# Tiled data written at runtime (drag-and-drop ingest, etc.).
# Demo datasets already committed under .tiled/data/ stay tracked; new arrays
# ingested locally are ignored. To commit a new demo dataset, use `git add -f`.
.tiled/data/

# Runtime Tiled thumbnail containers created on save
**/*__v_thumbs/

# Node
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# Process files
*.pid
.run/

# Editor
.idea/
.vscode/
*.swp

# Test / coverage artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Vendored SlimSAM weights (~75 MB) — fetch with:
#   node frontend/scripts/fetch-sam-model.mjs
frontend/public/models/

# Mark25 / TomoJEPA weights (~365 MB) — keep local; path via TOMOJEPA_WEIGHTS
ipred/models/*.pth
ipred/models/*.onnx

# Local runtime caches (feature banks, ipred catalog, etc.)
.local_data/

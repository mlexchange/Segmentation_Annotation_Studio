# Python
.venv/
.conda-py312/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Secrets — never commit
.env

# Tiled catalog database (binary, regenerated on first run via start_all.sh)
.tiled/catalog.db
.tiled/catalog.db-shm
.tiled/catalog.db-wal

# Tiled data written at runtime (drag-and-drop ingest, generated demos, etc.).
# Keep local arrays out of source control; regenerate them with the seed scripts.
.tiled/data/

# Runtime Tiled thumbnail containers created on save
**/*__v_thumbs/

# Node
node_modules/
dist/
.vite/

# Production SPA build served by FastAPI (generated by `PROD=1 ./start_all.sh`)
backend/static/

# OS
.DS_Store
Thumbs.db

# Process files
*.pid
.run/

# Editor
.idea/
.vscode/
*.swp

# Claude Code / Codex session-local tool state (per-machine, not project content)
.claude/
.codex/

# graphify-generated knowledge graph (regenerate with `/graphify`; large, not source)
graphify-out/

# Test / coverage artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Vendored SAM model (large, fetched via frontend/scripts/fetch-sam-model.mjs)
frontend/public/models/

# DINOv3 checkpoints (large .pth files; see backend/.env's DINO_MODELS_DIR)
backend/models/

# MkDocs build output (regenerate with `mkdocs build`)
site/

# peter's version of the repo
peter/

.reset-backups/
